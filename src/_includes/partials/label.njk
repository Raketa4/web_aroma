{#- Карточка статьи в виде аптечной этикетки. Ожидает переменную post. -#}
{%- set n = notes[post.data.note] -%}
{%- set slug = n.slug if n else "none" -%}
{%- set minutes = post.content | readingTime -%}
<article class="label label--{{ slug }}" data-note="{{ slug }}">
  {% if n %}<p class="label__note">{% include "partials/mini-pyramid.njk" %}{{ n.single }}</p>{% endif %}
  <h3 class="label__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  {% if post.data.oil %}
  <p class="label__oil">{{ post.data.oil }}{% if post.data.latin %}<br><i lang="la">{{ post.data.latin }}</i>{% endif %}</p>
  {% endif %}
  {% if post.data.description %}<p class="label__desc">{{ post.data.description }}</p>{% endif %}
  <p class="label__meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | ruDate }}</time>, {{ minutes }} {{ minutes | plural("минута", "минуты", "минут") }} чтения</p>
</article>
