{#- Маленькая пирамида нот: закрашен ярус, к которому относится масло. Для статей из «Основ» — капля. Ожидает переменную slug. -#}
{%- if slug == "basics" -%}
<svg class="mini-pyramid mini-pyramid--drop" viewBox="0 0 18 16" aria-hidden="true">
  <path class="is-on" d="M9 0.5C9 0.5 4.2 7.2 4.2 10.8a4.8 4.8 0 0 0 9.6 0C13.8 7.2 9 0.5 9 0.5Z"/>
</svg>
{%- else -%}
<svg class="mini-pyramid" viewBox="0 0 18 16" aria-hidden="true">
  <polygon class="{% if slug == 'top' %}is-on{% endif %}" points="9,0 11.8,5 6.2,5"/>
  <polygon class="{% if slug == 'heart' %}is-on{% endif %}" points="5.6,6 12.4,6 14.9,10.5 3.1,10.5"/>
  <polygon class="{% if slug == 'base' %}is-on{% endif %}" points="2.5,11.5 15.5,11.5 18,16 0,16"/>
</svg>
{%- endif -%}
